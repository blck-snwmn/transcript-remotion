{
  "name": "transcript-remotion",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "bun run scripts/render.ts",
    "transcribe": "bun run scripts/transcribe.ts",
    "build": "remotion bundle src/index.ts",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings . --fix",
    "fmt": "oxfmt --write src/ scripts/",
    "fmt:check": "oxfmt --check src/ scripts/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@google/genai": "2.20.0",
    "@remotion/captions": "4.0.520",
    "@remotion/cli": "4.0.520",
    "@remotion/media": "4.0.520",
    "@types/react": "19.2.18",
    "mediabunny": "1.55.5",
    "openai": "7.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.519",
    "zod": "4.5.4"
  }
}
