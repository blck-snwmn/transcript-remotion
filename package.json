{
  "name": "transcript-remotion",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "bun run scripts/render.ts",
    "transcribe": "bun run scripts/transcribe.ts",
    "build": "remotion bundle src/index.ts",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings . --fix",
    "fmt": "oxfmt --write src/ scripts/",
    "fmt:check": "oxfmt --check src/ scripts/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "bun-types": "1.4.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6.0.0 || ^7.0.0"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@remotion/captions": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/media": "4.0.535",
    "@types/react": "19.3.0",
    "mediabunny": "1.61.4",
    "openai": "7.33.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.535",
    "zod": "4.6.7"
  }
}
